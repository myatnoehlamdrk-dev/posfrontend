; SmartPOS USB printer (WinUSB) driver package
[Strings]
DeviceName = "SmartPOS USB Printer"
VendorName = "STMicroelectronics"
SourceName = "SmartPOS USB Printer Install Disk"
DeviceID   = "VID_0483&PID_5743"
DeviceGUID = "{4E6B9B77-993E-45F2-A877-3B1DAAD3FC2B}"

[Version]
Signature   = "$Windows NT$"
Class       = "USBDevice"
ClassGuid   = {88bae032-5a81-49f0-bc3d-a4ff138216d6}
Provider    = "SmartPOS"
CatalogFile = SmartPosUsb.cat
DriverVer   = 11/02/2026,1.0.0.0

[ClassInstall32]
Addreg = WinUSBDeviceClassReg

[WinUSBDeviceClassReg]
HKR,,,0,"Universal Serial Bus devices"
HKR,,Icon,,-20

[Manufacturer]
%VendorName% = SmartPOS_WinUSB,NTx86,NTamd64

[SmartPOS_WinUSB.NTx86]
%DeviceName% = USB_Install, USB\%DeviceID%

[SmartPOS_WinUSB.NTamd64]
%DeviceName% = USB_Install, USB\%DeviceID%

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include    = winusb.inf
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName   = "WinUSB - Kernel Driver"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WinUSB.sys

[USB_Install.Wdf]
KmdfService = WINUSB, WinUsb_Install

[WinUsb_Install]
KmdfLibraryVersion = 1.11

[USB_Install.HW]
AddReg = AddDeviceInterfaceGUID

[AddDeviceInterfaceGUID]
HKR,,DeviceInterfaceGUIDs,0x10000,%DeviceGUID%
