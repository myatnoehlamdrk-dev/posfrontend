<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ ignores the windowBackground splash and stamps the app icon
         instead. Re-point its animated icon at the composed splash image so the
         window splash shows the white-circle badge everywhere. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
