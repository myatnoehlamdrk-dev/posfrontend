<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <!-- Brand splash: a white circle with the badge centred on the navy
         window, matching the launcher icon. The circle sits inside the safe
         area, so Android 12+ can also display it without cropping. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>